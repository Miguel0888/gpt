{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://miguel0888.github.io/gpt/schemas/chat-stream-events.schema.json",
  "title": "ChatGPT web stream event payloads",
  "description": "JSON Schema definitions for observed stream event payloads.",
  "definitions": {
    "ConversationDeltaPayload": {
      "description": "Field-level payload schema unavailable in current observations."
    },
    "ConversationDeltaEncodingPayload": {
      "description": "The value v1 was observed; the complete payload structure was not captured."
    },
    "ConversationResumeToken": {
      "type": "object",
      "description": "JSON data event with type resume_conversation_token.",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "resume_conversation_token"
          ]
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": true
    },
    "ConversationInputMessage": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "input_message"
          ]
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": true
    },
    "ConversationTitleGeneration": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "title_generation"
          ]
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": true
    },
    "ConversationMessageMarker": {
      "type": "object",
      "description": "Observed marker values include cot_token, user_visible_token, final_channel_token and last_token. The marker field name is unknown.",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "message_marker"
          ]
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": true
    },
    "ConversationServerSteMetadata": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "server_ste_metadata"
          ]
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": true
    },
    "ConversationMessageStreamComplete": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "message_stream_complete"
          ]
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": true
    },
    "ConversationDetailMetadata": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "conversation_detail_metadata"
          ]
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": true
    },
    "ConversationDoneMarker": {
      "type": "string",
      "enum": [
        "[DONE]"
      ]
    },
    "FileProcessingEvent": {
      "type": "object",
      "description": "Observed line-delimited JSON event from POST /backend-api/files/process_upload_stream.",
      "properties": {
        "file_id": {
          "type": "string"
        },
        "event": {
          "type": "string",
          "enum": [
            "file.processing.started",
            "file.processing.file_ready",
            "file.indexing.completed",
            "file.processing.completed"
          ]
        },
        "message": {
          "type": "string"
        },
        "progress": {
          "type": "number",
          "description": "Observed as 0, 20 and 100 for some events; absent from the observed file.indexing.completed event."
        },
        "extra": {
          "description": "Observed as null in the supplied example; the actual type is not established."
        }
      },
      "required": [
        "file_id",
        "event"
      ],
      "additionalProperties": true
    }
  }
}
